generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String
  role      Role       @default(COMMERCIAL)
  avatarUrl String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  leads     Lead[]
  activities Activity[]
}

enum Role {
  ADMIN
  MARKETING
  COMMERCIAL
}

model Company {
  id        String       @id @default(uuid())
  name      String
  industry  String?
  size      CompanySize?
  website   String?
  linkedin  String?
  country   String?
  city      String?
  leads     Lead[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum CompanySize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

model Lead {
  id               String               @id @default(uuid())
  firstName        String
  lastName         String
  title            String?
  email            String?
  phone            String?
  linkedinUrl      String?
  linkedinProfile  Json?
  stage            Stage                @default(NEW)
  score            Int                  @default(0)
  scoreDemographic Int                  @default(0)
  scoreBehavioral  Int                  @default(0)
  isTarget         Boolean              @default(false)
  notes            String?
  companyId        String?
  company          Company?             @relation(fields: [companyId], references: [id])
  assignedToId     String?
  assignedTo       User?                @relation(fields: [assignedToId], references: [id])
  activities       Activity[]
  sequenceEnrollments SequenceEnrollment[]
  tags             String[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

enum Stage {
  NEW
  CONNECTED
  ENGAGED
  MQL
  SQL
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

model Activity {
  id        String       @id @default(uuid())
  type      ActivityType
  channel   Channel
  subject   String?
  content   String?
  metadata  Json?
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())
}

enum ActivityType {
  NOTE
  LINKEDIN_VIEW
  LINKEDIN_CONNECT
  LINKEDIN_MESSAGE
  LINKEDIN_INMAIL
  EMAIL_SENT
  EMAIL_RECEIVED
  CALL
  MEETING
  STAGE_CHANGE
  SCORE_CHANGE
}

enum Channel {
  LINKEDIN
  EMAIL
  PHONE
  IN_PERSON
  OTHER
}

model Sequence {
  id          String               @id @default(uuid())
  name        String
  description String?
  isActive    Boolean              @default(true)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model SequenceStep {
  id         String    @id @default(uuid())
  sequenceId String
  sequence   Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  channel    Channel
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])
  delayDays  Int       @default(0)
  subject    String?
  content    String?
}

model SequenceEnrollment {
  id           String           @id @default(uuid())
  sequenceId   String
  sequence     Sequence         @relation(fields: [sequenceId], references: [id])
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id])
  currentStep  Int              @default(0)
  status       EnrollmentStatus @default(ACTIVE)
  nextActionAt DateTime?
  enrolledAt   DateTime         @default(now())
  completedAt  DateTime?
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Template {
  id        String         @id @default(uuid())
  name      String
  channel   Channel
  subject   String?
  content   String
  variables String[]
  steps     SequenceStep[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Alert {
  id        String    @id @default(uuid())
  type      String
  message   String
  leadId    String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?
}
